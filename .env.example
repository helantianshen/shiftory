SHIFTORY_ENV_FILE=
SHIFTORY_HTTP_ADDR=:8080
SHIFTORY_DATABASE_DSN=root:123456@tcp(127.0.0.1:3306)/shiftory?charset=utf8mb4&parseTime=true&loc=UTC
SHIFTORY_TEST_DATABASE_DSN=root:123456@tcp(127.0.0.1:3306)/shiftory_test?charset=utf8mb4&parseTime=true&loc=UTC
SHIFTORY_UPLOAD_DIR=./uploads
SHIFTORY_WEB_DIR=../shiftory-web/dist
SHIFTORY_PUBLIC_ORIGIN=http://localhost:5173
SHIFTORY_JWT_ISSUER=shiftory-local
SHIFTORY_JWT_AUDIENCE=shiftory-web
SHIFTORY_JWT_PRIVATE_KEY_FILE=./var/jwt-private.pem
SHIFTORY_JWT_PUBLIC_KEY_FILE=./var/jwt-public.pem
SHIFTORY_AI_MODEL=deepseek-v4-flash-vision-exp
SHIFTORY_AI_BASE_URL=https://api.deepseek.com/v1
SHIFTORY_AI_API_KEY=replace-with-your-provider-key
SHIFTORY_AI_ENABLED=false
SHIFTORY_AI_REQUEST_TIMEOUT=90s
SHIFTORY_WORKER_ID=shiftory-worker-local
SHIFTORY_WORKER_POLL_INTERVAL=5s
SHIFTORY_WORKER_LEASE=3m
SHIFTORY_WORKER_MAX_CONCURRENCY=2
